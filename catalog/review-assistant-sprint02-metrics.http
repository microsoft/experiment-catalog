@baseURL = http://localhost:6020/api
@project = review-assistant-sprint02

### Get current metric definitions
GET {{baseURL}}/projects/{{project}}/metrics HTTP/1.1

### Define review assistant sprint 02 metrics
PUT {{baseURL}}/projects/{{project}}/metrics HTTP/1.1
Content-Type: application/json

[
  {
    "name": "generation_accuracy",
    "min": 0.0,
    "max": 1.0,
    "aggregate_function": "Average",
    "order": 100,
    "is_important": true
  },
